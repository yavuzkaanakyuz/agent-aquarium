# Copy to .env and fill in ONE provider. Without any key the offline "mock" mind runs (free, rule-based).
#   cp .env.example .env

# Provider: claude | gemini | openai | mock  (if unset: whichever key below is set, otherwise mock)
# LLM_PROVIDER=claude

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
# Default is claude-opus-5-5 ($4/$20 per 1M tokens). Much cheaper: claude-haiku-5-5 ($0.10/$0.50)
ANTHROPIC_MODEL=claude-haiku-5-5
# Thinking depth: low | medium | high (low is plenty for small decisions)
ANTHROPIC_EFFORT=low

# --- Google Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional thinking level (model dependent: minimal | low | medium | high)
# GEMINI_THINKING_LEVEL=low

# --- Any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, Ollama, LM Studio…) ---
# Example: OpenRouter with Claude Haiku
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-or-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-haiku-5.5

# --- Cost control ---
LLM_MAX_CALLS_PER_MIN=30
LLM_MAX_CONCURRENT=4
LLM_DAILY_TOKEN_BUDGET=2000000
LLM_MIN_THINK_TICKS=150
# USD per 1M tokens, to show a live cost estimate (known Claude models are filled in automatically)
# LLM_PRICE_IN_PER_M=0.10
# LLM_PRICE_OUT_PER_M=0.50

# --- Simulation ---
# SIM_PORT=8787        # server port (the dev client runs on 5173)
# HOST=127.0.0.1       # set 0.0.0.0 to expose on your network (anyone who can reach it controls the world!)
# SCARCITY=1           # resource scarcity multiplier (2 = resources regrow 2× slower → more competition)
# MAX_AGENTS=12        # population cap (every inhabitant makes LLM calls)
# PERMADEATH=0         # disable death by starvation (default: on)
# FRESH=1              # start a new world instead of resuming the autosave
# SEED=42              # fixed world seed
